          "toPort": "hs"
        },
        {
          "from": "head",
          "fromPort": "chunk",
          "to": "loss",
          "toPort": "chunk",
          "label": "pred"
        },
        {
          "from": "agt",
          "fromPort": "action",
          "to": "loss",
          "toPort": "action",
          "label": "GT"
        },
        {
          "from": "cvae",
          "fromPort": "z",
          "to": "loss",
          "toPort": "z",
          "label": "KL"
        },
        {
          "from": "loss",
          "fromPort": "grad",
          "to": "opt",
          "toPort": "grad"
        }
      ]
    },
